# Runtime boundary
# internal_pilot: ECS single-room internal employee simulation staging
# production: guardrails reject debug defaults; current repo is not real-patient production-ready
APP_ENV=internal_pilot
PILOT_MODE=false
DEBUG_PAYLOAD_LEVEL=raw
ENABLE_LIVE_TRANSFER=false
# Optional: allow internal_pilot token minting for rooms with this prefix.
# If unset, internal_pilot only allows LIVEKIT_ROOM_NAME.
# LIVEKIT_ALLOWED_ROOM_PREFIX=debug-full

# Alibaba Cloud DashScope API
DASHSCOPE_API_KEY=your_api_key_here

# Qwen LLM defaults
# Speech lane: low latency, no-thinking mode.
# Fast Judge lane: live critical-path structured extraction and routing.
# Analyzer lane: memory extraction and optional non-critical analyzers.
# Plus lanes upgraded to qwen3.7-plus (2026-06); Flash critical path unchanged.
CONVERSATION_MODEL=qwen3.6-flash
CONVERSATION_ENABLE_THINKING=false
ANALYZER_MODEL=qwen3.7-plus
ANALYZER_MAX_TOKENS=300
ANALYZER_TEMPERATURE=0.0
# Fast Judge is the only live Judge path; this flag is retained for compatibility.
FAST_JUDGE_ENABLED=true
FAST_JUDGE_MODEL=qwen3.6-flash
FAST_JUDGE_MAX_TOKENS=400
FAST_JUDGE_TEMPERATURE=0.0
FAST_JUDGE_TIMEOUT_S=4.0

# ASR latency
STT_STANDBY_ENABLED=true

# DashScope 网络配置
# 公网默认：
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
# DASHSCOPE_HTTP_API_URL=https://dashscope.aliyuncs.com/api/v1
# DASHSCOPE_WS_API_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
# DASHSCOPE_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#
# ECS 内网推荐：
# 1. 在北京地域同一 VPC 创建 PrivateLink 终端节点，服务选择 com.aliyuncs.dashscope
# 2. 终端节点安全组放通 80/443
# 3. 如需 HTTPS / WSS，配置自定义服务域名或内网 DNS（Private Hosted Zone）
# 4. 然后开启 USE_VPC_ENDPOINT，并按实际内网域名覆盖下面三个地址
# USE_VPC_ENDPOINT=true
# DASHSCOPE_VPC_BASE_URL=https://vpc-cn-beijing.dashscope.aliyuncs.com
# DASHSCOPE_VPC_HTTP_API_URL=https://vpc-cn-beijing.dashscope.aliyuncs.com/api/v1
# DASHSCOPE_VPC_WS_API_URL=wss://vpc-cn-beijing.dashscope.aliyuncs.com/api-ws/v1/inference
# DASHSCOPE_VPC_COMPATIBLE_BASE_URL=https://vpc-cn-beijing.dashscope.aliyuncs.com/compatible-mode/v1

# Dev Mode - must remain false for ECS staging and production
DEV_MODE=false

# LiveKit Server
# ECS co-located staging should let pinchi-agent connect directly to loopback
# LiveKit. Browsers connect through nginx using VITE_LIVEKIT_URL.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=replace_with_livekit_api_key
LIVEKIT_API_SECRET=replace_with_livekit_api_secret
LIVEKIT_ROOM_NAME=debug-full
LIVEKIT_AGENT_IDENTITY=agent

# ── Live 3-way concurrency (on-demand subprocess dispatcher) ──
# Allow per-call unique rooms (frontend generates pinchi-live-<csr>-<ts>-<rand>)
LIVEKIT_ALLOWED_ROOM_PREFIX=pinchi-live-
MAX_LIVE_AGENTS=3
# Per-child RSS budget (MiB) enforced by the reaper watchdog (no-swap OOM net)
LIVE_PER_CHILD_RSS_MAX_MB=900
LIVE_MAX_CALL_SECONDS=1800
# Frontend build flags (set in the frontend build env / .env consumed by Vite):
VITE_UNIQUE_ROOM_PER_LOAD=true
VITE_ROOM_NAME=pinchi-live

# Conference-only native voice experiments; all keys remain server-side.
# OPENAI_API_KEY=
# DEMO_OPENAI_API_KEY=
# DEMO_QWEN_API_KEY=
# DEMO_QWEN_WS_URL=wss://your-workspace.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
# The existing account was also verified against the public DashScope realtime endpoint.
# DEMO_OPENAI_VOICE=marin
# Optional OpenAI-only HTTP CONNECT egress; Qwen never uses this setting.
# DEMO_OPENAI_PROXY=http://127.0.0.1:18182
# DEMO_QWEN_VOICE=longanqian_v3.1
