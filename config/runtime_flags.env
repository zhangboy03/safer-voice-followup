# Single source of truth for runtime BEHAVIOR flags.
#
# Loaded identically by the production deploy and by every eval harness
# (Study 1/2/3) so the evaluation measures the configuration we actually ship
# and production stays reproducible from the repo — not from a hand-edited
# ECS .env.
#
# These three were added late-May (commits a8a798a / 59095eb / 004779c),
# default OFF in src/core/config.py, and were turned ON in production by hand
# in /opt/pinchi_ai_call_center/.env. Confirmed live ON on the ECS box on
# 2026-06-02. Recording them here makes the shipped config visible, versioned,
# and identical across prod and eval.
#
# To change behavior, edit ONE line here; it then applies to prod AND eval.
STAGE1_FOLLOWUP_ENABLED=true
STAGE2_ENTRY_PROMPT_ENABLED=true
JUDGE_ADVANCE_QUESTION_GUARD_ENABLED=true
# speech_prior_state_snapshot_enabled stays at its code default (off): it was
# never wired into the live path (no call site outside tests), so enabling it
# would be a no-op. Left out deliberately.
# Conversational brain: "solo" (single-flash + native tools) | "brain" (dual-LLM SOP).
AGENT_BRAIN=solo
# A2: bounded grace (ms) for the ASR final before the timeout fallback emits
# partial-derived text. Matches the config default; set 0 to disable (= pre-A2 behavior).
ASR_FINAL_GRACE_MS=400
